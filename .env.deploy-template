# ═══════════════════════════════════════════════════════════════
# clauded — Per-Deployment Configuration
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env.deploy-N (e.g. .env.deploy-1, .env.deploy-2)
# Each deployment is a separate Telegram bot serving a team or client.

# ── Deployment Identity ──────────────────────────────────────
# A friendly name for logs and identification
DEPLOYMENT_NAME=department-name

# ── Telegram Bot ─────────────────────────────────────────────
# Each deployment MUST have its own bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-for-this-deployment

# Authorized Telegram chat IDs (comma-separated)
# Only these users can interact with this deployment's bot
ALLOWED_CHAT_ID=111111111,222222222

# ── Telegram Webhook (production) ────────────────────────────
# Uncomment for webhook mode (recommended on public servers)
# The path must be unique per deployment
# TELEGRAM_WEBHOOK_URL=https://clauded.example.com/webhook/deploy-1
# TELEGRAM_WEBHOOK_SECRET=generate-unique-secret-per-deployment

# ── Web UI ───────────────────────────────────────────────────
# Each deployment gets its own web UI port (internal, proxied by Caddy)
VOICE_WEB_PORT=3031
# Users generate their own tokens via /webtoken create
# Legacy shared token (optional fallback):
# VOICE_WEB_TOKEN=optional-legacy-token

# ── Database Mode ────────────────────────────────────────────
# Shared mode (default): uses the DB_NAME from .env.production
#   → All departments share the same data (work orders, cards, etc.)
#   → Users are isolated by chat_id (per-user scoping)
#
# Isolated mode: override DB_NAME for this deployment
#   → This deployment gets its own database
#   → Complete data separation from other deployments
#   → Recommended for client-facing deployments
#
# To enable isolated mode, uncomment:
# DB_NAME=clauded_client_acme

# ── Pack Subscriptions ───────────────────────────────────────
# Which domain packs this deployment has access to
# (Users can enable/disable via /pack commands)
# Default: all packs available

# ── GitHub (optional) ────────────────────────────────────────
# GH_TOKEN=ghp_xxxx

# ── Paths ────────────────────────────────────────────────────
# These are set per-deployment in docker-compose.production.yml
# via volume mounts. No need to override here.
STORE_DIR=/app/store
WORKSPACE_DIR=/app/workspace
