# ═══════════════════════════════════════════════════════════════
# clauded — Production Shared Configuration
# ═══════════════════════════════════════════════════════════════
#
# Shared settings used by ALL bot deployments on this server.
# Copy this file to .env.production and fill in the values.

# ── Domain & HTTPS ────────────────────────────────────────────
# Your public domain (Caddy will auto-obtain TLS certificate)
CADDY_DOMAIN=clauded.example.com

# ── Database ──────────────────────────────────────────────────
# Choose ONE: mariadb or postgres
# Start the matching profile: --profile mariadb OR --profile postgres
DB_DRIVER=mariadb
DB_HOST=mariadb          # Docker service name (mariadb or postgres)
DB_PORT=3306             # 3306 for MariaDB, 5432 for PostgreSQL
DB_NAME=clauded          # Shared mode: same DB for all bots
DB_USER=clauded
DB_PASSWORD=generate-a-strong-password-here
DB_ROOT_PASSWORD=generate-a-different-strong-password-here

# Connection pool (shared across all bots)
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── Claude AI ────────────────────────────────────────────────
# Shared Claude subscription (all bots use the same token)
# Generated with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token-here

# ── AI Provider Default ──────────────────────────────────────
AI_PROVIDER=claude

# ── Ollama ───────────────────────────────────────────────────
# Shared Ollama instance (Docker service name)
OLLAMA_HOST=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3.5:latest
OLLAMA_TOOL_MODEL=qwen3.5:latest

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
