.DS_Store
.claude/
node_modules/
dist/
store/*
!store/.gitkeep
workspace/*
!workspace/.gitkeep
!workspace/uploads/
workspace/uploads/*
!workspace/uploads/.gitkeep
*.log
.env
.env.local
.env.production
.env.development
.gstack/
.memsearch/
# Bridge/web certs — real certs are deployment-only; placeholder is the exception
certs/*.pem
!certs/bridge-cert.pem
