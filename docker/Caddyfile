# Caddy reverse proxy for Luna
#
# Provides: automatic HTTPS (Let's Encrypt), HTTP/2, WebSocket proxy,
# request size limits, basic security headers.
#
# Configuration via environment variables:
#   CADDY_DOMAIN — your domain (e.g. luna.example.com)
#                  Set to ":443" for IP-based access with self-signed cert
#                  Set to "localhost" for local development
#
# For production: point your domain's DNS to this server, then Caddy
# automatically obtains and renews TLS certificates from Let's Encrypt.

{$CADDY_DOMAIN:localhost} {
	# ── Request limits ──
	# Prevent large payload attacks (10MB max body)
	request_body {
		max_size 10MB
	}

	# ── Security headers (supplement Luna's own headers) ──
	header {
		# HSTS — enforce HTTPS for 1 year
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Prevent MIME type sniffing
		X-Content-Type-Options "nosniff"
		# Clickjacking protection
		X-Frame-Options "DENY"
		# XSS filter
		X-XSS-Protection "1; mode=block"
		# No referrer on cross-origin
		Referrer-Policy "no-referrer"
		# Remove server identification
		-Server
	}

	# ── Rate limiting ──
	# Basic connection rate limiting (Caddy built-in)
	# For advanced rate limiting, use fail2ban at the OS level

	# ── Reverse proxy to Luna web server ──
	# WebSocket upgrade handled automatically by Caddy
	reverse_proxy luna:3030 {
		# Health check — Caddy marks backend unhealthy if it fails
		health_uri /
		health_interval 30s
		health_timeout 5s

		# Preserve client IP for audit logging
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# WebSocket support (board, voice, learn)
		transport http {
			# Allow WebSocket connections
			versions h2c 1.1
		}
	}

	# ── Logging ──
	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 5
		}
		format json
	}
}

# ── HTTP → HTTPS redirect (automatic with Caddy) ──
# Caddy automatically redirects HTTP (port 80) to HTTPS (port 443)
# when a domain is configured. No manual redirect needed.
