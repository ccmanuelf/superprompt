#!/usr/bin/env bash
# sam <subcommand> — NovaLink SAM API wrapper for the claude -p subprocess.
# (specs docs/superpowers/specs/2026-07-13-sam-claude-path-design.md §1 and
#  docs/superpowers/specs/2026-07-14-sam-phase2-analytics-design.md §1)
#
#   sam health                           GET /health + /whoami
#   sam search <kind> [querystring]      kinds: products|analyses|measured_times|machines|clients
#   sam get <id> [--full]                GET /analyses/{id}  (--full keeps full_json)
#   sam create <client|product> <json>   POST /clients | /products
#   sam generate <json>                  POST /analyses/generate  (--max-time 180)
#   sam generate-mm <json> --file <path> [--file <path>]...
#                                        multipart POST /analyses/generate-mm (--max-time 180, <=8 files)
#   sam set-status <id> <status> [pct]   PATCH /analyses/{id}
#   sam export <id>                      GET /analyses/{id}/export.xlsx → uploads dir, prints path
#   sam update <id> <json>               PATCH /analyses/{id} (operations[], balance_defaults, total_sam_min, …)
#   sam review <id> [--no-ai]            POST /analyses/{id}/review?use_ai=true|false
#   sam balance <id> [querystring]       GET /analyses/{id}/line-balance[?qs]
#   sam balance-whatif <id> <json>       POST /analyses/{id}/line-balance  (recompute, saves nothing)
#   sam scenarios <id>                   GET /analyses/{id}/scenarios
#   sam scenario-save <id> <json>        POST /analyses/{id}/scenarios
#   sam estimate <json>                  POST /estimate-sequence
#   sam cells | sam cell <id>            GET /cells | /cells/{id}
#   sam cell-create <json>               POST /cells
#   sam cell-update <id> <json>          PATCH /cells/{id}
#   sam cell-simulate <id> <json>        POST /cells/{id}/simulate
#   sam cell-erv <id> <json>             POST /cells/{id}/compute-erv
#   sam cell-export <id>                 GET /cells/{id}/export.xlsx → uploads dir, prints path
#   sam calc <operation|sequence|line-balance> <json>   POST /calc/{…}
#   sam library [querystring]            GET /library[?qs]
#   sam candidates-scan <json>           POST /library/candidates/scan
#   sam candidates [querystring]         GET /library/candidates[?qs]
#   sam api <METHOD> <path> [json]       generic /api/v1 passthrough
#                                        (GET|POST|PUT|PATCH only; path must start with /)
#
# Auth key and base URL come from the environment; the key is never echoed
# or logged. Error bodies are the API's JSON with a `detail` field (FastAPI).
set -euo pipefail
: "${NOVALINK_SAM_URL:?NOVALINK_SAM_URL not set}"
: "${NOVALINK_SAM_API_KEY:?NOVALINK_SAM_API_KEY not set}"

BASE="${NOVALINK_SAM_URL%/}/api/v1"
AUTH="Authorization: Bearer $NOVALINK_SAM_API_KEY"
UPLOADS_DIR="${SAM_UPLOADS_DIR:-/app/workspace/uploads}"
USAGE="usage: sam health | search <kind> [qs] | get <id> [--full] | create <client|product> <json> | generate <json> | generate-mm <json> --file <path>... | set-status <id> <status> [pct] | export <id> | update <id> <json> | review <id> [--no-ai] | balance <id> [qs] | balance-whatif <id> <json> | scenarios <id> | scenario-save <id> <json> | estimate <json> | cells | cell <id> | cell-create <json> | cell-update <id> <json> | cell-simulate <id> <json> | cell-erv <id> <json> | cell-export <id> | calc <operation|sequence|line-balance> <json> | library [qs] | candidates-scan <json> | candidates [qs] | api <METHOD> <path> [json]"

[ $# -ge 1 ] || { echo "$USAGE" >&2; exit 2; }
cmd="$1"; shift

case "$cmd" in
  health)
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/health"; echo
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/whoami"; echo
    ;;
  search)
    [ $# -ge 1 ] || { echo "usage: sam search <kind> [querystring]" >&2; exit 2; }
    # kinds map exactly as SEARCH_KINDS in src/providers/tools/sam.ts
    case "$1" in
      products)       path="/products" ;;
      analyses)       path="/analyses" ;;
      measured_times) path="/measured-times" ;;
      machines)       path="/machines" ;;
      clients)        path="/clients" ;;
      *) echo "unknown kind '$1' (products|analyses|measured_times|machines|clients)" >&2; exit 2 ;;
    esac
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE$path${2:+?$2}"
    ;;
  get)
    [ $# -ge 1 ] || { echo "usage: sam get <id> [--full]" >&2; exit 2; }
    if [ "${2:-}" = "--full" ]; then
      curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/analyses/$1"
    else
      # Default: drop the 20-section full_json blob (context economy). The
      # image has node (node:26-slim base) but no jq — filter with node.
      curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/analyses/$1" | node -e '
        let s = "";
        process.stdin.on("data", (d) => { s += d; });
        process.stdin.on("end", () => {
          try {
            const o = JSON.parse(s);
            if (o && typeof o === "object" && !Array.isArray(o) && "full_json" in o) {
              delete o.full_json;
              o._full_json_omitted = "full_json omitted; re-run with --full if the user explicitly needs it";
            }
            console.log(JSON.stringify(o));
          } catch { process.stdout.write(s); }
        });'
    fi
    ;;
  create)
    [ $# -ge 2 ] || { echo "usage: sam create <client|product> <json>" >&2; exit 2; }
    case "$1" in
      client)  path="/clients" ;;
      product) path="/products" ;;
      *) echo "unknown create kind '$1' (client|product)" >&2; exit 2 ;;
    esac
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE$path"
    ;;
  generate)
    [ $# -ge 1 ] || { echo "usage: sam generate <json>" >&2; exit 2; }
    # Server-side AI draft: ~60-120 s, costs the SAM server's own credits.
    curl -sS --fail-with-body --max-time 180 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$1" "$BASE/analyses/generate"
    ;;
  generate-mm)
    # Multimodal AI draft from tech-pack images/PDF (handoff v1.1 §4).
    # json fields → individual multipart form fields via node (same
    # no-eval-JSON-in-shell rationale as set-status); each --file → a
    # files=@ part. Server limits: <=8 files, <=12 MB each,
    # png/jpg/webp/gif/pdf; the <=8 is also enforced here.
    [ $# -ge 3 ] || { echo "usage: sam generate-mm <json> --file <path> [--file <path>]..." >&2; exit 2; }
    mmjson="$1"; shift
    mmfiles=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --file)
          [ $# -ge 2 ] || { echo "--file needs a path" >&2; exit 2; }
          mmfiles+=("$2"); shift 2 ;;
        *) echo "unexpected argument '$1' (only --file <path> after the json)" >&2; exit 2 ;;
      esac
    done
    [ ${#mmfiles[@]} -ge 1 ] || { echo "at least one --file <path> is required" >&2; exit 2; }
    [ ${#mmfiles[@]} -le 8 ] || { echo "too many files: ${#mmfiles[@]} (server limit is 8)" >&2; exit 2; }
    for f in "${mmfiles[@]}"; do
      # Reject curl -F microsyntax metacharacters: a path with ';' or ','
      # lets curl parse ';type='/';filename=' suffixes and spoof the part's
      # content-type/filename, independent of bash quoting. Uploads are
      # timestamp_name.ext — no legitimate path reaches here with these.
      case "$f" in *[";,"]*) echo "generate-mm: file path may not contain ';' or ',': $f" >&2; exit 2 ;; esac
      [ -f "$f" ] || { echo "file not found: $f" >&2; exit 2; }
    done
    # Validate the json up front — the emitter below runs in a process
    # substitution whose exit code set -e cannot see.
    node -e 'const o = JSON.parse(process.argv[1]); if (!o || typeof o !== "object" || Array.isArray(o)) { console.error("json must be an object"); process.exit(1); }' "$mmjson" \
      || { echo "invalid json for generate-mm" >&2; exit 2; }
    # Emit NUL-separated name=value pairs (nested objects JSON-encoded;
    # null/undefined skipped). --form-string, not -F, for these: a value
    # starting with @ or < must be sent literally, never read a local file.
    form_args=()
    while IFS= read -r -d '' pair; do
      form_args+=(--form-string "$pair")
    done < <(node -e '
      const o = JSON.parse(process.argv[1]);
      for (const [k, v] of Object.entries(o)) {
        if (v === null || v === undefined) continue;
        const s = typeof v === "object" ? JSON.stringify(v) : String(v);
        process.stdout.write(`${k}=${s}\u0000`);
      }' "$mmjson")
    # Pin filename explicitly so even an odd-but-allowed name can't influence
    # the part metadata; basename is safe — ';'/',' already rejected above.
    for f in "${mmfiles[@]}"; do form_args+=(-F "files=@$f;filename=$(basename "$f")"); done
    # Opus multimodal draft: ~60-120 s, costs the SAM server's own credits.
    curl -sS --fail-with-body --max-time 180 -H "$AUTH" \
      -X POST "${form_args[@]}" "$BASE/analyses/generate-mm"
    ;;
  set-status)
    [ $# -ge 2 ] || { echo "usage: sam set-status <id> <status> [confidence_pct]" >&2; exit 2; }
    # Build the body with JSON.stringify (not printf interpolation) so a
    # status value containing quotes cannot inject arbitrary JSON keys.
    body=$(node -e 'const [s, c] = process.argv.slice(1); const b = { status: s }; if (c !== undefined && c !== "") b.confidence_pct = Number(c); process.stdout.write(JSON.stringify(b));' "$2" "${3:-}")
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X PATCH -d "$body" "$BASE/analyses/$1"
    ;;
  export)
    [ $# -ge 1 ] || { echo "usage: sam export <id>" >&2; exit 2; }
    # $1 lands raw in the uploads filename — constrain to the API's integer ids.
    case "$1" in ''|*[!0-9]*) echo "sam export: id must be numeric" >&2; exit 2 ;; esac
    out="$UPLOADS_DIR/$(date +%s%3N)_sam-analysis-$1.xlsx"
    # On HTTP error --fail-with-body writes the error body into $out, but
    # curl still exits non-zero, so set -e aborts before the path is echoed
    # — a bad .xlsx is never announced.
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -o "$out" "$BASE/analyses/$1/export.xlsx"
    echo "$out"
    ;;
  update)
    [ $# -ge 2 ] || { echo "usage: sam update <id> <json>" >&2; exit 2; }
    # Extended PATCH (handoff v1.1 §4): status / confidence_pct / full_json /
    # balance_defaults / total_sam_min / operations[] (replaces the set).
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X PATCH -d "$2" "$BASE/analyses/$1"
    ;;
  review)
    [ $# -ge 1 ] || { echo "usage: sam review <id> [--no-ai]" >&2; exit 2; }
    use_ai=true
    if [ "${2:-}" = "--no-ai" ]; then use_ai=false; fi
    # use_ai=true runs an AI verdict leg on the SAM server — allow 120 s.
    curl -sS --fail-with-body --max-time 120 -H "$AUTH" \
      -X POST "$BASE/analyses/$1/review?use_ai=$use_ai"
    ;;
  balance)
    [ $# -ge 1 ] || { echo "usage: sam balance <id> [querystring]" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/analyses/$1/line-balance${2:+?$2}"
    ;;
  balance-whatif)
    [ $# -ge 2 ] || { echo "usage: sam balance-whatif <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/analyses/$1/line-balance"
    ;;
  scenarios)
    [ $# -ge 1 ] || { echo "usage: sam scenarios <id>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/analyses/$1/scenarios"
    ;;
  scenario-save)
    [ $# -ge 2 ] || { echo "usage: sam scenario-save <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/analyses/$1/scenarios"
    ;;
  estimate)
    [ $# -ge 1 ] || { echo "usage: sam estimate <json>" >&2; exit 2; }
    # use_ai_for_gaps:true fills unmatched steps with GSD/MOST — allow 120 s.
    curl -sS --fail-with-body --max-time 120 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$1" "$BASE/estimate-sequence"
    ;;
  cells)
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/cells"
    ;;
  cell)
    [ $# -ge 1 ] || { echo "usage: sam cell <id>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/cells/$1"
    ;;
  cell-create)
    [ $# -ge 1 ] || { echo "usage: sam cell-create <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$1" "$BASE/cells"
    ;;
  cell-update)
    [ $# -ge 2 ] || { echo "usage: sam cell-update <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X PATCH -d "$2" "$BASE/cells/$1"
    ;;
  cell-simulate)
    [ $# -ge 2 ] || { echo "usage: sam cell-simulate <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/cells/$1/simulate"
    ;;
  cell-erv)
    [ $# -ge 2 ] || { echo "usage: sam cell-erv <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/cells/$1/compute-erv"
    ;;
  cell-export)
    [ $# -ge 1 ] || { echo "usage: sam cell-export <id>" >&2; exit 2; }
    # $1 lands raw in the uploads filename — constrain to the API's integer ids.
    case "$1" in ''|*[!0-9]*) echo "sam cell-export: id must be numeric" >&2; exit 2 ;; esac
    out="$UPLOADS_DIR/$(date +%s%3N)_sam-cell-$1.xlsx"
    # Same shape as sam export: on HTTP error --fail-with-body writes the
    # error body into $out but curl exits non-zero, so set -e aborts before
    # the path is echoed — a bad .xlsx is never announced.
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -o "$out" "$BASE/cells/$1/export.xlsx"
    echo "$out"
    ;;
  calc)
    [ $# -ge 2 ] || { echo "usage: sam calc <operation|sequence|line-balance> <json>" >&2; exit 2; }
    case "$1" in
      operation|sequence|line-balance) ;;
      *) echo "unknown calc kind '$1' (operation|sequence|line-balance)" >&2; exit 2 ;;
    esac
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/calc/$1"
    ;;
  library)
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/library${1:+?$1}"
    ;;
  candidates-scan)
    [ $# -ge 1 ] || { echo "usage: sam candidates-scan <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$1" "$BASE/library/candidates/scan"
    ;;
  candidates)
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/library/candidates${1:+?$1}"
    ;;
  api)
    # Generic /api/v1 passthrough for the long tail + future endpoints
    # (discovery surface: sam api GET /openapi.json). Guards per spec §1:
    # METHOD whitelist (no DELETE unless SAM ships one — then via spec
    # update); path must start with /; body passed through as-is.
    [ $# -ge 2 ] || { echo "usage: sam api <METHOD> <path> [json]" >&2; exit 2; }
    method="$1"; apipath="$2"; apibody="${3:-}"
    case "$method" in
      GET|POST|PUT|PATCH) ;;
      *) echo "method '$method' not allowed (GET|POST|PUT|PATCH)" >&2; exit 2 ;;
    esac
    case "$apipath" in
      /*) ;;
      *) echo "path must start with '/' (got '$apipath')" >&2; exit 2 ;;
    esac
    # Reject '..' path segments: curl normalizes $BASE/api/v1/../../x to /x
    # on the wire BEFORE sending — escaping the /api/v1 scope with the
    # bearer key attached. Covers leading, trailing, embedded, and bare '..'.
    case "$apipath" in
      */../*|*/..|../*|..) echo "sam api: path may not contain '..' segments" >&2; exit 2 ;;
    esac
    if [ -n "$apibody" ]; then
      curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
        -X "$method" -d "$apibody" "$BASE$apipath"
    else
      curl -sS --fail-with-body --max-time 30 -H "$AUTH" -X "$method" "$BASE$apipath"
    fi
    ;;
  *)
    echo "$USAGE" >&2; exit 2
    ;;
esac
