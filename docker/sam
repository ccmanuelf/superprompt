#!/usr/bin/env bash
# sam <subcommand> — NovaLink SAM API wrapper for the claude -p subprocess.
# (specs docs/superpowers/specs/2026-07-13-sam-claude-path-design.md §1 and
#  docs/superpowers/specs/2026-07-14-sam-phase2-analytics-design.md §1)
#
#   sam health                           GET /health + /whoami
#   sam search <kind> [querystring]      kinds: products|analyses|measured_times|machines|clients
#   sam get <id> [--full]                GET /analyses/{id}  (--full keeps full_json)
#   sam create <client|product> <json>   POST /clients | /products
#   sam generate <json>                  POST /analyses/generate  (600 s connection +
#                                        300 s poll recovery when persisted; full_json stripped)
#   sam generate-mm <json> --file <path> [--file <path>]...
#                                        multipart POST /analyses/generate-mm (<=8 files; same
#                                        600 s + 300 s budget; always persists, so a dropped
#                                        connection is always recovered and full_json stripped)
#   sam set-status <id> <status> [pct]   PATCH /analyses/{id}
#   sam export <id>                      GET /analyses/{id}/export.xlsx → uploads dir, prints path
#   sam update <id> <json>               PATCH /analyses/{id} (operations[], balance_defaults, total_sam_min, …)
#   sam review <id> [--no-ai]            POST /analyses/{id}/review?use_ai=true|false
#   sam balance <id> [querystring]       GET /analyses/{id}/line-balance[?qs]
#   sam balance-whatif <id> <json>       POST /analyses/{id}/line-balance  (recompute, saves nothing)
#   sam scenarios <id>                   GET /analyses/{id}/scenarios
#   sam scenario-save <id> <json>        POST /analyses/{id}/scenarios
#   sam estimate <json>                  POST /estimate-sequence
#   sam cells | sam cell <id>            GET /cells | /cells/{id}
#   sam cell-create <json>               POST /cells
#   sam cell-update <id> <json>          PATCH /cells/{id}
#   sam cell-simulate <id> <json>        POST /cells/{id}/simulate
#   sam cell-erv <id> <json>             POST /cells/{id}/compute-erv
#   sam cell-export <id>                 GET /cells/{id}/export.xlsx → uploads dir, prints path
#   sam calc <operation|sequence|line-balance> <json>   POST /calc/{…}
#   sam library [querystring]            GET /library[?qs]
#   sam candidates-scan <json>           POST /library/candidates/scan
#   sam candidates [querystring]         GET /library/candidates[?qs]
#   sam api <METHOD> <path> [json]       generic /api/v1 passthrough
#                                        (GET|POST|PUT|PATCH only; path must start with /)
#
# Auth key and base URL come from the environment; the key is never echoed
# or logged. Error bodies are the API's JSON with a `detail` field (FastAPI).
set -euo pipefail
: "${NOVALINK_SAM_URL:?NOVALINK_SAM_URL not set}"
: "${NOVALINK_SAM_API_KEY:?NOVALINK_SAM_API_KEY not set}"

ROOT="${NOVALINK_SAM_URL%/}"
BASE="$ROOT/api/v1"
AUTH="Authorization: Bearer $NOVALINK_SAM_API_KEY"
UPLOADS_DIR="${SAM_UPLOADS_DIR:-/app/workspace/uploads}"
USAGE="usage: sam health | openapi | search <kind> [qs] | get <id> [--full] | create <client|product> <json> | generate <json> | generate-mm <json> --file <path>... | set-status <id> <status> [pct] | export <id> | update <id> <json> | review <id> [--no-ai] | balance <id> [qs] | balance-whatif <id> <json> | scenarios <id> | scenario-save <id> <json> | estimate <json> | cells | cell <id> | cell-create <json> | cell-update <id> <json> | cell-simulate <id> <json> | cell-erv <id> <json> | cell-export <id> | calc <operation|sequence|line-balance> <json> | library [qs] | candidates-scan <json> | candidates [qs] | api <METHOD> <path> [json]"

[ $# -ge 1 ] || { echo "$USAGE" >&2; exit 2; }
cmd="$1"; shift

# Drop the 20-section full_json blob from an analysis payload (context economy
# — a fresh generate returns ~66 operations AND every section, and the model
# then has to read all of it inside the turn budget). Only strips when the
# payload carries an `id`: a persist=false draft is never stored, so its
# full_json is the only copy in existence and must pass through untouched.
# The image has node (node:26-slim base) but no jq — filter with node.
strip_full_json() {
  node -e '
    let s = "";
    process.stdin.on("data", (d) => { s += d; });
    process.stdin.on("end", () => {
      try {
        const o = JSON.parse(s);
        if (o && typeof o === "object" && !Array.isArray(o) && "full_json" in o && o.id != null) {
          delete o.full_json;
          o._full_json_omitted = "full_json omitted; re-run `sam get <id> --full` if the user explicitly needs it";
        }
        console.log(JSON.stringify(o));
      } catch { process.stdout.write(s); }
    });'
}

# ── Generate timeouts + client-timeout recovery ──────────────────────
# Measured 2026-08-10 on the subscription backend: a 4-file generate-mm
# takes ~7 min to insert the analysis row and ~12 min to finish writing it
# (analysis 46: created 19:41:43, finished 19:49:17; analysis 47: created
# 20:28:43, finished 20:33:37). A synchronous HTTP call that long is not
# reliable, and when curl gives up the SERVER KEEPS GOING and stores the
# analysis anyway — which is how the same draft got generated repeatedly
# and looked like a failure every time.
#
# So: bound the connection, then recover by polling for what the server
# actually stored. Ladder — curl 600 s + poll 300 s = 900 s wrapper ceiling
# < bash/IPC 930 s < CLAUDE_TIMEOUT_MS.
# Overridable only so the recovery path can be exercised in a test harness
# with a stub curl; production never sets these.
GEN_MAX_TIME="${SAM_GEN_MAX_TIME:-600}"
POLL_BUDGET="${SAM_POLL_BUDGET:-300}"
POLL_INTERVAL="${SAM_POLL_INTERVAL:-20}"

# Extract a field from a JSON object argument (prints empty on any problem).
json_field() {
  node -e '
    try {
      const o = JSON.parse(process.argv[1]);
      const v = o?.[process.argv[2]];
      if (v !== undefined && v !== null) process.stdout.write(String(v));
    } catch {}' "$1" "$2"
}

# After the client connection times out, find the analysis SAM created for
# this request and wait for it to finish. Args: <product_id> <since_iso>.
# Prints the completed analysis JSON on success; prints nothing on failure.
#
# "Finished" = SAM's own `generation_status` says so (rc.147). It replaces an
# `updated_at`-held-steady-across-two-polls heuristic that could return EARLY
# AND WRONG: the engine review is a SEPARATE 5-8 min AI call, so updated_at
# sits unchanged for minutes between the analysis committing and the review
# writing its verdict — far longer than two POLL_INTERVALs. The old check
# would have handed back a `pending` draft (no engine_review, non-final status
# and quote_gate) tagged as the finished result of the call. Never fired in
# production, so it was undetected rather than fixed.
poll_for_analysis() {
  local pid="$1" since="$2"
  local deadline id="" detail created gen
  deadline=$(( $(date +%s) + POLL_BUDGET ))

  while [ "$(date +%s)" -lt "$deadline" ]; do
    sleep "$POLL_INTERVAL"

    # Identify the candidate once: newest analysis for this product whose
    # created_at is at/after the moment we fired the request.
    if [ -z "$id" ]; then
      local listing newest
      listing=$(curl -sS --max-time 30 -H "$AUTH" "$BASE/analyses?limit=10&sort=-created_at" 2>/dev/null || true)
      [ -n "$listing" ] || continue
      newest=$(node -e '
        try {
          const rows = JSON.parse(process.argv[1]);
          const pid = String(process.argv[2]);
          const hit = (Array.isArray(rows) ? rows : []).find((r) => String(r.product_id) === pid);
          if (hit?.id != null) process.stdout.write(String(hit.id));
        } catch {}' "$listing" "$pid")
      [ -n "$newest" ] || continue
      detail=$(curl -sS --max-time 30 -H "$AUTH" "$BASE/analyses/$newest" 2>/dev/null || true)
      created=$(json_field "$detail" created_at)
      # String compare is correct here — both are ISO-8601 UTC from the API.
      [ -n "$created" ] && [ "$created" \> "$since" ] || continue
      id="$newest"
      >&2 echo "sam: found analysis $id created at $created — waiting for it to finish"
    fi

    detail=$(curl -sS --max-time 30 -H "$AUTH" "$BASE/analyses/$id" 2>/dev/null || true)
    [ -n "$detail" ] || continue
    gen=$(json_field "$detail" generation_status)

    # complete = the engine review landed; status and quote_gate are final.
    # failed   = the draft saved but the review errored — usable, uncertified,
    #            and no further polling will change it, so return it rather
    #            than burn the remaining budget. The payload carries
    #            generation_status itself, so the model can see which it got.
    # anything else (pending) = the second AI call is still running; keep waiting.
    if [ "$gen" = "complete" ] || [ "$gen" = "failed" ]; then
      printf '%s' "$detail" | node -e '
        let s = "";
        process.stdin.on("data", (d) => { s += d; });
        process.stdin.on("end", () => {
          try {
            const o = JSON.parse(s);
            delete o.full_json;
            o._full_json_omitted = "full_json omitted; re-run `sam get <id> --full` if the user explicitly needs it";
            o._recovered_after_client_timeout =
              "The HTTP connection timed out but SAM finished the draft and stored it. "
              + "This IS the result of that call — report it as such. Do NOT generate again.";
            console.log(JSON.stringify(o));
          } catch { process.stdout.write(s); }
        });'
      return 0
    fi
  done
  return 1
}

# Run a generate call, recovering the persisted result if the connection
# times out. Args: <product_id> <persisted:0|1> <curl args...>
generate_with_recovery() {
  local pid="$1" persisted="$2"; shift 2
  local started resp rc recovered
  started=$(date -u +%Y-%m-%dT%H:%M:%S)

  set +e
  resp=$(curl -sS --fail-with-body --max-time "$GEN_MAX_TIME" "$@")
  rc=$?
  set -e

  if [ "$rc" -eq 0 ]; then
    printf '%s' "$resp" | strip_full_json
    return 0
  fi

  # 28 = curl's own operation timeout. Any other failure is a real API
  # error whose body curl already emitted — pass it through untouched.
  if [ "$rc" -ne 28 ]; then
    [ -n "$resp" ] && printf '%s' "$resp"
    return "$rc"
  fi

  if [ "$persisted" != "1" ] || [ -z "$pid" ]; then
    >&2 echo "sam: connection timed out after ${GEN_MAX_TIME}s and this call does not persist — nothing to recover; the draft is lost. Do NOT retry blind; ask the user first."
    return 28
  fi

  >&2 echo "sam: connection timed out after ${GEN_MAX_TIME}s with no response body. SAM keeps working server-side, so polling for the stored analysis (up to ${POLL_BUDGET}s)…"
  set +e
  recovered=$(poll_for_analysis "$pid" "$started")
  rc=$?
  set -e
  if [ "$rc" -eq 0 ] && [ -n "$recovered" ]; then
    printf '%s' "$recovered"
    return 0
  fi

  >&2 echo "sam: no completed analysis appeared within ${POLL_BUDGET}s. SAM is very likely STILL generating it — do NOT call generate again. Wait, then run: sam search analyses \"limit=5&sort=-created_at\""
  return 28
}

case "$cmd" in
  health)
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/health"; echo
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/whoami"; echo
    ;;
  openapi)
    # Machine-readable API contract. FastAPI serves it at the APP ROOT
    # (/openapi.json), NOT under /api/v1 — so this is a dedicated subcommand,
    # not `sam api GET /openapi.json` (which 404s against the /api/v1 base).
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$ROOT/openapi.json"
    ;;
  search)
    [ $# -ge 1 ] || { echo "usage: sam search <kind> [querystring]" >&2; exit 2; }
    # kinds map exactly as SEARCH_KINDS in src/providers/tools/sam.ts
    case "$1" in
      products)       path="/products" ;;
      analyses)       path="/analyses" ;;
      measured_times) path="/measured-times" ;;
      machines)       path="/machines" ;;
      clients)        path="/clients" ;;
      *) echo "unknown kind '$1' (products|analyses|measured_times|machines|clients)" >&2; exit 2 ;;
    esac
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE$path${2:+?$2}"
    ;;
  get)
    [ $# -ge 1 ] || { echo "usage: sam get <id> [--full]" >&2; exit 2; }
    if [ "${2:-}" = "--full" ]; then
      curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/analyses/$1"
    else
      curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/analyses/$1" | strip_full_json
    fi
    ;;
  create)
    [ $# -ge 2 ] || { echo "usage: sam create <client|product> <json>" >&2; exit 2; }
    case "$1" in
      client)  path="/clients" ;;
      product) path="/products" ;;
      *) echo "unknown create kind '$1' (client|product)" >&2; exit 2 ;;
    esac
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE$path"
    ;;
  generate)
    [ $# -ge 1 ] || { echo "usage: sam generate <json>" >&2; exit 2; }
    # Server-side AI draft on the subscription backend. persist=true → the
    # result is recoverable by polling if the connection dies (and full_json
    # is stripped, re-fetchable via `sam get`). A persist=false draft is
    # never stored, so it can be neither recovered nor stripped.
    gen_persist=0
    [ "$(json_field "$1" persist)" = "true" ] && gen_persist=1
    generate_with_recovery "$(json_field "$1" product_id)" "$gen_persist" \
      -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$1" "$BASE/analyses/generate"
    ;;
  generate-mm)
    # Multimodal AI draft from tech-pack images/PDF (handoff v1.1 §4).
    # json fields → individual multipart form fields via node (same
    # no-eval-JSON-in-shell rationale as set-status); each --file → a
    # files=@ part. Server limits: <=8 files, <=12 MB each,
    # png/jpg/webp/gif/pdf; the <=8 is also enforced here.
    [ $# -ge 3 ] || { echo "usage: sam generate-mm <json> --file <path> [--file <path>]..." >&2; exit 2; }
    mmjson="$1"; shift
    mmfiles=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --file)
          [ $# -ge 2 ] || { echo "--file needs a path" >&2; exit 2; }
          mmfiles+=("$2"); shift 2 ;;
        *) echo "unexpected argument '$1' (only --file <path> after the json)" >&2; exit 2 ;;
      esac
    done
    [ ${#mmfiles[@]} -ge 1 ] || { echo "at least one --file <path> is required" >&2; exit 2; }
    [ ${#mmfiles[@]} -le 8 ] || { echo "too many files: ${#mmfiles[@]} (server limit is 8)" >&2; exit 2; }
    for f in "${mmfiles[@]}"; do
      # Reject curl -F microsyntax metacharacters: a path with ';' or ','
      # lets curl parse ';type='/';filename=' suffixes and spoof the part's
      # content-type/filename, independent of bash quoting. Uploads are
      # timestamp_name.ext — no legitimate path reaches here with these.
      case "$f" in *[";,"]*) echo "generate-mm: file path may not contain ';' or ',': $f" >&2; exit 2 ;; esac
      [ -f "$f" ] || { echo "file not found: $f" >&2; exit 2; }
    done
    # Validate the json up front — the emitter below runs in a process
    # substitution whose exit code set -e cannot see.
    node -e 'const o = JSON.parse(process.argv[1]); if (!o || typeof o !== "object" || Array.isArray(o)) { console.error("json must be an object"); process.exit(1); }' "$mmjson" \
      || { echo "invalid json for generate-mm" >&2; exit 2; }
    # Emit NUL-separated name=value pairs (nested objects JSON-encoded;
    # null/undefined skipped). --form-string, not -F, for these: a value
    # starting with @ or < must be sent literally, never read a local file.
    form_args=()
    while IFS= read -r -d '' pair; do
      form_args+=(--form-string "$pair")
    done < <(node -e '
      const o = JSON.parse(process.argv[1]);
      for (const [k, v] of Object.entries(o)) {
        if (v === null || v === undefined) continue;
        const s = typeof v === "object" ? JSON.stringify(v) : String(v);
        process.stdout.write(`${k}=${s}\u0000`);
      }' "$mmjson")
    # Pin filename explicitly so even an odd-but-allowed name can't influence
    # the part metadata; basename is safe — ';'/',' already rejected above.
    for f in "${mmfiles[@]}"; do form_args+=(-F "files=@$f;filename=$(basename "$f")"); done
    # Opus multimodal draft — the slowest call SAM serves (~12 min measured
    # with 4 tech-pack files). ALWAYS persists, so a connection timeout is
    # always recoverable by polling, and full_json is always stripped: the
    # sections stay one `sam get --full` away and the model gets its turn
    # budget back for the reply.
    generate_with_recovery "$(json_field "$mmjson" product_id)" 1 \
      -H "$AUTH" -X POST "${form_args[@]}" "$BASE/analyses/generate-mm"
    ;;
  set-status)
    [ $# -ge 2 ] || { echo "usage: sam set-status <id> <status> [confidence_pct]" >&2; exit 2; }
    # Approvals need a NAMED human actor and this wrapper cannot supply one:
    # it authenticates with a service key, and API-key principals have no
    # username, so an approval made here records as `service:readwrite`.
    # `review` means the engine refused to certify the number, so approving is
    # a person overriding that refusal — "a machine approved it" is not an
    # audit answer. SAM moved approvals to the Web UI, which records who
    # decided, why, and the gate verdict frozen as it stood. Refused in the
    # wrapper rather than the prompt on purpose: a prompt rule is probabilistic
    # and a persuasive "just approve it, I'll take responsibility" could talk
    # the model past it. `superseded` stays allowed — bookkeeping, not a
    # judgement about whether a number is defensible.
    if [ "$2" = "approved" ]; then
      echo "sam set-status: refusing to set 'approved'. Approvals must be made by a named person in the SAM Web UI — https://192.168.2.234:8443/ui/ (or http://192.168.2.234:8080/ui/ on the LAN) — which records the actor, the reason, and the quote-gate verdict as it stood at decision time. This wrapper's service key would record the approver as 'service:readwrite', which is not an audit trail. Tell the user to approve it there; 'superseded' is still fine from here." >&2
      exit 3
    fi
    # Build the body with JSON.stringify (not printf interpolation) so a
    # status value containing quotes cannot inject arbitrary JSON keys.
    body=$(node -e 'const [s, c] = process.argv.slice(1); const b = { status: s }; if (c !== undefined && c !== "") b.confidence_pct = Number(c); process.stdout.write(JSON.stringify(b));' "$2" "${3:-}")
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X PATCH -d "$body" "$BASE/analyses/$1"
    ;;
  export)
    [ $# -ge 1 ] || { echo "usage: sam export <id>" >&2; exit 2; }
    # $1 lands raw in the uploads filename — constrain to the API's integer ids.
    case "$1" in ''|*[!0-9]*) echo "sam export: id must be numeric" >&2; exit 2 ;; esac
    out="$UPLOADS_DIR/$(date +%s%3N)_sam-analysis-$1.xlsx"
    # On HTTP error --fail-with-body writes the error body into $out, but
    # curl still exits non-zero, so set -e aborts before the path is echoed
    # — a bad .xlsx is never announced.
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -o "$out" "$BASE/analyses/$1/export.xlsx"
    echo "$out"
    ;;
  update)
    [ $# -ge 2 ] || { echo "usage: sam update <id> <json>" >&2; exit 2; }
    # Extended PATCH (handoff v1.1 §4): status / confidence_pct / full_json /
    # balance_defaults / total_sam_min / operations[] (replaces the set).
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X PATCH -d "$2" "$BASE/analyses/$1"
    ;;
  review)
    [ $# -ge 1 ] || { echo "usage: sam review <id> [--no-ai]" >&2; exit 2; }
    use_ai=true
    if [ "${2:-}" = "--no-ai" ]; then use_ai=false; fi
    # use_ai=true runs an AI verdict leg on the SAM server — ~1-3 min on the
    # subscription backend, so allow 240 s.
    curl -sS --fail-with-body --max-time 240 -H "$AUTH" \
      -X POST "$BASE/analyses/$1/review?use_ai=$use_ai"
    ;;
  balance)
    [ $# -ge 1 ] || { echo "usage: sam balance <id> [querystring]" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/analyses/$1/line-balance${2:+?$2}"
    ;;
  balance-whatif)
    [ $# -ge 2 ] || { echo "usage: sam balance-whatif <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/analyses/$1/line-balance"
    ;;
  scenarios)
    [ $# -ge 1 ] || { echo "usage: sam scenarios <id>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/analyses/$1/scenarios"
    ;;
  scenario-save)
    [ $# -ge 2 ] || { echo "usage: sam scenario-save <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/analyses/$1/scenarios"
    ;;
  estimate)
    [ $# -ge 1 ] || { echo "usage: sam estimate <json>" >&2; exit 2; }
    # use_ai_for_gaps:true fills unmatched steps with GSD/MOST — ~1-3 min on
    # the subscription backend, so allow 240 s.
    curl -sS --fail-with-body --max-time 240 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$1" "$BASE/estimate-sequence"
    ;;
  cells)
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/cells"
    ;;
  cell)
    [ $# -ge 1 ] || { echo "usage: sam cell <id>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/cells/$1"
    ;;
  cell-create)
    [ $# -ge 1 ] || { echo "usage: sam cell-create <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$1" "$BASE/cells"
    ;;
  cell-update)
    [ $# -ge 2 ] || { echo "usage: sam cell-update <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X PATCH -d "$2" "$BASE/cells/$1"
    ;;
  cell-simulate)
    [ $# -ge 2 ] || { echo "usage: sam cell-simulate <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/cells/$1/simulate"
    ;;
  cell-erv)
    [ $# -ge 2 ] || { echo "usage: sam cell-erv <id> <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/cells/$1/compute-erv"
    ;;
  cell-export)
    [ $# -ge 1 ] || { echo "usage: sam cell-export <id>" >&2; exit 2; }
    # $1 lands raw in the uploads filename — constrain to the API's integer ids.
    case "$1" in ''|*[!0-9]*) echo "sam cell-export: id must be numeric" >&2; exit 2 ;; esac
    out="$UPLOADS_DIR/$(date +%s%3N)_sam-cell-$1.xlsx"
    # Same shape as sam export: on HTTP error --fail-with-body writes the
    # error body into $out but curl exits non-zero, so set -e aborts before
    # the path is echoed — a bad .xlsx is never announced.
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -o "$out" "$BASE/cells/$1/export.xlsx"
    echo "$out"
    ;;
  calc)
    [ $# -ge 2 ] || { echo "usage: sam calc <operation|sequence|line-balance> <json>" >&2; exit 2; }
    case "$1" in
      operation|sequence|line-balance) ;;
      *) echo "unknown calc kind '$1' (operation|sequence|line-balance)" >&2; exit 2 ;;
    esac
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$2" "$BASE/calc/$1"
    ;;
  library)
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/library${1:+?$1}"
    ;;
  candidates-scan)
    [ $# -ge 1 ] || { echo "usage: sam candidates-scan <json>" >&2; exit 2; }
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
      -X POST -d "$1" "$BASE/library/candidates/scan"
    ;;
  candidates)
    curl -sS --fail-with-body --max-time 30 -H "$AUTH" "$BASE/library/candidates${1:+?$1}"
    ;;
  api)
    # Generic /api/v1 passthrough for the long tail + future endpoints
    # (discovery surface: `sam openapi`, served at the app root). Guards per spec §1:
    # METHOD whitelist (no DELETE unless SAM ships one — then via spec
    # update); path must start with /; body passed through as-is.
    [ $# -ge 2 ] || { echo "usage: sam api <METHOD> <path> [json]" >&2; exit 2; }
    method="$1"; apipath="$2"; apibody="${3:-}"
    case "$method" in
      GET|POST|PUT|PATCH) ;;
      *) echo "method '$method' not allowed (GET|POST|PUT|PATCH)" >&2; exit 2 ;;
    esac
    case "$apipath" in
      /*) ;;
      *) echo "path must start with '/' (got '$apipath')" >&2; exit 2 ;;
    esac
    # Reject '..' path segments: curl normalizes $BASE/api/v1/../../x to /x
    # on the wire BEFORE sending — escaping the /api/v1 scope with the
    # bearer key attached. Covers leading, trailing, embedded, and bare '..'.
    case "$apipath" in
      */../*|*/..|../*|..) echo "sam api: path may not contain '..' segments" >&2; exit 2 ;;
    esac
    if [ -n "$apibody" ]; then
      curl -sS --fail-with-body --max-time 30 -H "$AUTH" -H 'Content-Type: application/json' \
        -X "$method" -d "$apibody" "$BASE$apipath"
    else
      curl -sS --fail-with-body --max-time 30 -H "$AUTH" -X "$method" "$BASE$apipath"
    fi
    ;;
  *)
    echo "$USAGE" >&2; exit 2
    ;;
esac
