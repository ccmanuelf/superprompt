# Docker-specific environment overrides
# These override values from .env when running inside Docker containers.

# Ollama: runs on the host Mac, not inside Docker
OLLAMA_HOST=http://host.docker.internal:11434

# Voice: Speaches is on the internal Docker network, not localhost
SPEACHES_URL=http://speaches:8000/v1

# Matrix: Synapse is on the internal Docker network
MATRIX_HOMESERVER=http://synapse:8008

# Search: SearXNG on the internal Docker network (auto-configured)
SEARXNG_URL=http://searxng:8080

# Paths inside the container
STORE_DIR=/app/store
WORKSPACE_DIR=/app/workspace
