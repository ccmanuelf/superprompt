# ════════════════════════════════════════════════════════════════
# Luna — Environment Configuration
# ════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored and contains secrets.
#
# After changing .env, restart Luna:
#   docker compose restart luna
#
# Not sure what to set? Ask Luna: "help me configure the web UI"
# or "what Ollama model should I use?" — it can guide you through
# any setting, even the ones it can't change directly.
#
# ════════════════════════════════════════════════════════════════


# ── MESSAGING PLATFORM (at least one required) ──────────────
#
# You must configure at least one messaging platform (Telegram or Matrix).
# If neither is configured, Luna will refuse to start.


# TELEGRAM
# ────────
# Required if using Telegram (most users start here).
#
# How to get your bot token:
#   1. Open Telegram and message @BotFather
#   2. Send /newbot and follow the prompts
#   3. Copy the token (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
#
# If missing: Telegram bot does not start. If Matrix is also not configured,
# Luna refuses to start entirely.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ── Telegram Webhook (production, optional) ───────────────
#
# By default, Luna uses long-polling (outbound connections to Telegram).
# For production on a public server, webhook mode is more efficient:
# Telegram sends updates to your HTTPS endpoint directly.
#
# Requires: Caddy (or other reverse proxy) providing HTTPS on the domain.
#
# TELEGRAM_WEBHOOK_URL=https://luna.example.com/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
#
# The webhook secret is verified by Telegram on each request — prevents
# unauthorized POST requests to the webhook endpoint.

# SECURITY — Authorized Telegram chat IDs.
# Comma-separated list of numeric chat IDs allowed to use the bot.
#
# How to get your chat ID:
#   1. Leave this empty and start Luna
#   2. Send any message to your bot
#   3. Send /chatid — the bot replies with your numeric ID
#   4. Paste that ID here and restart Luna
#
# WARNING: If empty, the bot accepts messages from ANY Telegram user.
# This is intentional for first-time setup only. Always set this in production.
ALLOWED_CHAT_ID=


# MATRIX (optional)
# ─────────────────
# Self-hosted Matrix homeserver via Synapse. Only needed if you want Matrix
# in addition to (or instead of) Telegram.
#
# Setup guide: reference/matrix-setup.md
#
# If MATRIX_HOMESERVER or MATRIX_ACCESS_TOKEN is empty, Matrix bot does not start.
# MATRIX_HOMESERVER=http://localhost:8008
# MATRIX_ACCESS_TOKEN=your-matrix-access-token-here
#
# SECURITY — Authorized Matrix user IDs. Same rules as ALLOWED_CHAT_ID:
# if empty, ANY Matrix user can message the bot.
# Format: @username:server.domain (comma-separated for multiple)
# MATRIX_ALLOWED_USERS=@youruser:luna.local


# ── AI PROVIDERS ────────────────────────────────────────────
#
# Luna supports two AI backends. You can use one or both.
#
# rc.95 — Luna is local-first by default. Ollama handles routine turns;
# Claude is the escalation path for long/complex reasoning and document
# generation. The Claude subscription is a flat monthly fee with no
# per-call cost, but local-first keeps subscription rate-limit headroom
# free for the turns that actually need Claude. Use the /usage command
# to see the per-provider call count for the current month.

# Default AI provider: "claude" or "ollama"
# This is the provider used when auto-routing is off, or as the baseline
# when auto-routing keeps a chat sticky to one side.
AI_PROVIDER=ollama

# Automatic provider routing: when true (default), Luna analyzes each
# message and routes to the best provider (Ollama for short/factual/tool
# turns, Claude for long-form reasoning and document generation). Set to
# false to lock every turn to AI_PROVIDER unconditionally. Toggle per
# chat at runtime with the /auto command.
AUTO_ROUTE=true


# CLAUDE
# ──────
# Uses the Claude CLI (claude -p) as a subprocess. Requires a Claude subscription
# (Max plan) and a long-lived OAuth token for headless/Docker usage.
#
# How to generate the token:
#   1. Install Claude CLI: npm install -g @anthropic-ai/claude-code
#   2. Run: claude setup-token
#   3. Follow the browser-based auth flow
#   4. Copy the token output here
#
# The token is valid for approximately 1 year. If Claude stops responding,
# regenerate with: claude setup-token
#
# If missing: Claude provider is unavailable. Ollama still works.
# If expired: Claude requests fail with auth error — regenerate the token.
CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token-here


# OLLAMA
# ──────
# Connects to Ollama running on the host machine (not inside Docker).
# Ollama must be installed and running before starting Luna.
#
# Install: https://ollama.ai
# Pull required models before first run:
#   ollama pull qwen3.5:latest
#   ollama pull nomic-embed-text
#
# If Ollama is not running: Ollama requests fail with connection error.
# The error is shown in chat — Luna does not crash.
# If a model is not pulled: First request fails with "model not found".
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:latest
OLLAMA_TOOL_MODEL=qwen3.5:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
# Idle model residency (Ollama keep_alive). Default 3m. On a RAM-constrained
# host (e.g. 16 GB running qwen3.5:4b + Speaches), shorten to reclaim RAM
# faster between idle turns, e.g. 60s. Set 0 to unload immediately after each call.
# OLLAMA_KEEP_ALIVE=3m


# ── VOICE (Speaches sidecar) ───────────────────────────────
#
# Voice processing is handled by the Speaches Docker container (included
# in docker-compose.yml). It provides local STT and TTS — no cloud services.
#
# STT model: Systran/faster-whisper-small (auto-detects 99 languages)
# TTS model: Kokoro-82M (voices: af_heart for English, ef_dora for Spanish)
#
# Models are loaded automatically by the entrypoint script on first startup
# (takes ~30 seconds). Subsequent starts use cached models.
#
# If Speaches is unreachable: Voice features degrade gracefully — the bot
# transcribes nothing and replies with text only. It does not crash.
#
# You should NOT need to change this unless running Speaches on a different host.
# In Docker, this is automatically overridden to http://speaches:8000/v1
SPEACHES_URL=http://localhost:8000/v1


# ── WEB UI (Voice Chat, Dashboards, Documentation) ─────────
#
# Luna serves a web interface with:
#   - Voice chat (push-to-talk + VAD mode)
#   - Manufacturing dashboards (/sim, /capacity, /sequence, etc.)
#   - Kanban board (/board)
#   - Learning coach (/learn)
#   - Documentation viewer (/docs)
#
# The web UI is DISABLED by default. To enable it, uncomment both lines below.
# Both VOICE_WEB_PORT and VOICE_WEB_TOKEN are required — if either is missing,
# the web server does not start.
#
# VOICE_WEB_PORT: The port to serve the web UI on.
# VOICE_WEB_TOKEN: Optional fallback token for authentication.
#   Per-user tokens are now the recommended approach — users generate their own
#   via /webtoken create [label] [ttl] in Telegram. Each per-user token is scoped
#   to the user's chat_id, isolating board cards, learning plans, memory, and
#   schedules. If VOICE_WEB_TOKEN is set, it still works as a shared fallback
#   (backward compatible). Choose a strong random string (32+ characters).
#   Example: openssl rand -hex 32
#
# SECURITY: If neither VOICE_WEB_TOKEN nor per-user tokens are configured,
# ANYONE who can reach the port can use the web UI.
# The server refuses to start if the port is set but the token is empty and
# no per-user tokens exist.
#
# VOICE_WEB_PORT=3030
# VOICE_WEB_TOKEN=your-secret-token-here
#
# ── CADDY REVERSE PROXY (production HTTPS) ────────────────
#
# For production deployments, Caddy provides automatic HTTPS via Let's
# Encrypt. Set your domain and start with: docker compose --profile production up
#
# CADDY_DOMAIN=luna.example.com
#
# For IP-based access (no domain): CADDY_DOMAIN=:443
# For local development: leave unset (defaults to localhost)
#
# Caddy automatically:
# - Obtains and renews TLS certificates from Let's Encrypt
# - Redirects HTTP (80) to HTTPS (443)
# - Limits request body to 10MB
# - Adds HSTS, X-Frame-Options, and other security headers
# - Proxies WebSocket connections to Luna
# - Logs access in JSON format to /data/access.log
#
# TLS / HTTPS (manual — only if NOT using Caddy)
# ──────────
# Browsers require HTTPS for microphone access on non-localhost domains.
# If you access the web UI from a remote machine without Caddy, configure TLS.
#
# How to generate a self-signed certificate (for testing):
#   openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 -nodes
#
# For production, use Let's Encrypt or your organization's CA.
#
# If these paths point to files that don't exist, the web server will log an
# error and remain disabled (Luna continues running without the web UI).
#
# VOICE_WEB_TLS_CERT=/path/to/cert.pem
# VOICE_WEB_TLS_KEY=/path/to/key.pem
#
# Allowed Origin (optional, for cloud/remote deployments)
# ───────────────
# When the web UI is accessed from a different domain (not localhost),
# set this to the exact origin URL to prevent cross-site WebSocket hijacking.
# If empty, only localhost connections are allowed (secure default).
#
# Example: https://luna.example.com
# VOICE_WEB_ORIGIN=


# ── FILE ACCESS (Ollama tools) ──────────────────────────────
#
# The Ollama read_file and parse_file tools can read files from the host.
# For security, access is restricted to paths listed here.
#
# Format: Comma-separated absolute paths. The tool checks if the requested
# file's resolved path starts with any of these prefixes.
#
# If empty: File reading is completely blocked (except uploaded files).
# This is the secure default — set it only if you need file access.
#
# Example (macOS):
# OLLAMA_ALLOWED_PATHS=/Users/yourname/Documents,/Users/yourname/Projects
#
# Example (Linux):
# OLLAMA_ALLOWED_PATHS=/home/yourname/projects,/var/log
OLLAMA_ALLOWED_PATHS=


# ── WEB SEARCH ─────────────────────────────────────────────
#
# IMPORTANT: Required for web search when using the Ollama provider.
# Claude has built-in web search and does not need this.
#
# DOCKER DEPLOYMENTS: SearXNG is included in docker-compose.yml and
# auto-configured — no action needed. It runs as an internal service
# on the Docker network (not exposed to host). Web search works
# out of the box with Ollama.
#
# NON-DOCKER DEPLOYMENTS: Configure at least ONE backend:
#
# Option A: SearXNG (self-hosted, private, recommended)
#   Install: https://docs.searxng.org/admin/installation.html
#   Or via Docker: docker run -p 8888:8080 searxng/searxng
#
# Option B: Brave Search API (cloud, requires API key)
#   Sign up: https://brave.com/search/api/
#   Free tier: 2,000 queries/month
#
# If NEITHER is set and not using Docker: The web_search tool returns
# "No search backend available" when called via Ollama.
#
# SEARXNG_URL=http://localhost:8888
# BRAVE_API_KEY=your-brave-api-key-here


# ── GITHUB INTEGRATION (optional) ──────────────────────────
#
# Enables GitHub tools: list repos, read files, create PRs, etc.
# Uses the gh CLI installed inside the Docker container.
#
# How to generate:
#   1. Go to https://github.com/settings/tokens
#   2. Create a fine-grained or classic token
#   3. Required scopes: repo, read:org
#
# If missing: GitHub tools return "gh CLI not authenticated" error.
# If expired: GitHub tools return authorization errors — regenerate the token.
# GH_TOKEN=ghp_your-token-here


# ── RENDER INTEGRATION (optional) ──────────────────────────
#
# Enables deployment monitoring tools: list services, check deploys, view logs.
#
# How to generate:
#   1. Go to https://dashboard.render.com/u/settings#api-keys
#   2. Create an API key
#
# If missing: Render tools return "RENDER_API_KEY not set" error.
# RENDER_API_KEY=rnd_your-key-here


# ── DATABASE ────────────────────────────────────────────────
#
# All database access goes through Knex. Select your driver:
#
# DB_DRIVER: "sqlite" (default), "mariadb", or "postgres"
#
# SQLite requires no additional configuration — data is stored in ./store/.
# MariaDB and PostgreSQL require connection details:
#
# DB_DRIVER=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=luna
# DB_PASSWORD=your-db-password-here
# DB_NAME=luna
#
# Migration script: npx ts-node scripts/migrate-database.ts
# Migrates schema from SQLite to MariaDB/PostgreSQL.


# ── PATHS (optional overrides) ──────────────────────────────
#
# Override default data directories. You should NOT need to change these
# unless you have a specific reason. Docker overrides these automatically
# via docker/.env.docker.
#
# STORE_DIR: Where the SQLite database and persistent state are stored.
#   Default: ./store (host) or /app/store (Docker)
#
# WORKSPACE_DIR: Where temporary files (uploads, screenshots, repos) are stored.
#   Default: ./workspace (host) or /app/workspace (Docker)
#
# STORE_DIR=./store
# WORKSPACE_DIR=./workspace


# ── LOGGING ─────────────────────────────────────────────────
#
# Controls the minimum log level. Lower levels include more detail.
# Valid values: debug, info, warn, error
#
# debug  — Everything including internal state changes (verbose)
# info   — Normal operations: startup, connections, tool usage (default)
# warn   — Potential problems: missing optional config, degraded services
# error  — Failures that affect functionality
#
# If invalid value: Defaults to "info" silently.
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════
# WORKER SANDBOX (SA1)
# ═══════════════════════════════════════════════════════════════
#
# Controls timeout behavior for user-generated tool execution in Worker threads.
# The Worker sandbox provides V8 isolation for all generated_code tools.
#
# TOOL_TIMEOUT_MS — Base timeout (milliseconds). Worker killed if no heartbeat
# within this window. Default: 30000 (30 seconds).
# For resource-constrained hosts, increase this.
# TOOL_TIMEOUT_MS=30000
#
# TOOL_MAX_TIMEOUT_MS — Hard ceiling (milliseconds). Worker killed regardless
# of heartbeats. Default: 360000 (6 minutes).
# Users can override per-execution via conversational _timeout parameter.
# TOOL_MAX_TIMEOUT_MS=360000

# CLAUDE_TIMEOUT_MS — Circuit breaker timeout for Claude CLI subprocess.
# If Claude doesn't respond within this time, the subprocess is killed.
# Default: 120000 (2 minutes).
# CLAUDE_TIMEOUT_MS=120000

# OLLAMA_TIMEOUT_MS — Hard HTTP request timeout for Ollama.
# Applied via AbortSignal + undici headers/body timeouts. If the model
# doesn't respond within this window (e.g. OOM / swap thrash), the
# request is aborted and a bilingual error surfaces to the user.
# Default: 600000 (10 minutes) — matches CLAUDE_TIMEOUT_MS precedent.
# OLLAMA_TIMEOUT_MS=600000

# ANTHROPIC_DISCOVERY_API_KEY — OPTIONAL, for /cmodels discovery only.
#
# IMPORTANT: Deliberately named ANTHROPIC_DISCOVERY_API_KEY (NOT the
# standard ANTHROPIC_API_KEY). The Claude CLI reads ANTHROPIC_API_KEY
# and, if set, uses it for inference — switching billing from your
# OAuth subscription to pay-per-token. This var uses a name the CLI
# does not know, so it cannot leak into billing.
#
# Used ONLY by providers/claude.ts listModels() against the metadata
# endpoint GET https://api.anthropic.com/v1/models. That endpoint
# returns a JSON list with zero token usage. The response is cached
# in-memory for 24h so even the free endpoint is called at most once
# per day.
#
# Additional defense in depth: providers/claude.ts strips both
# ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN from the subprocess env
# before spawning the CLI, so even if you accidentally export the
# standard names the CLI will not see them.
#
# Leave unset to disable /cmodels discovery — /cmodel <name> still
# works via probe validation.
# ANTHROPIC_DISCOVERY_API_KEY=sk-ant-api03-your-key-here

# ═══════════════════════════════════════════════════════════════
# RATE LIMITING (rc.25)
# ═══════════════════════════════════════════════════════════════
#
# Per-user, per-provider rate limits prevent cost spirals at scale.
# When limit is reached, bilingual message suggests switching provider.
#
# RATE_LIMIT_CLAUDE_MAX — Max Claude calls per user per hour. Default: 100
# RATE_LIMIT_CLAUDE_MAX=100
#
# RATE_LIMIT_OLLAMA_MAX — Max Ollama calls per user per hour. Default: 200
# RATE_LIMIT_OLLAMA_MAX=200
#
# RATE_LIMIT_WINDOW_MINUTES — Window size in minutes. Default: 60
# RATE_LIMIT_WINDOW_MINUTES=60

# ═══════════════════════════════════════════════════════════════
# POLICY ENGINE (rc.30 — CTO feedback)
# ═══════════════════════════════════════════════════════════════
#
# POLICY_CONFIRM_HIGH_RISK — Comma-separated list of high-risk tools
# that should require user confirmation before execution.
# By default, high-risk tools execute with logging only.
# For stricter environments, list specific tools here.
# Example: POLICY_CONFIRM_HIGH_RISK=read_file,web_search,take_screenshot
# Default: empty (no high-risk tools require confirmation)
# POLICY_CONFIRM_HIGH_RISK=

# ── NOVALINK BRIDGE (optional) ─────────────────────────────
#
# Enables NovaLink production-data tools: novalink_list_queries,
# novalink_query, novalink_health. Read-only access via the NovaLink
# Bridge on the internal Docker network (superprompt_luna-net).
#
# If missing: NovaLink tools return "NOVALINK_BRIDGE_URL / NOVALINK_BRIDGE_API_KEY not set".
# NOVALINK_BRIDGE_URL=http://novalink-bridge:5000
# NOVALINK_BRIDGE_API_KEY=your-novalink-key-here
