# clauded — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.

# ── AI Provider ──────────────────────────────────────────────
# Default AI provider: "claude" or "ollama"
AI_PROVIDER=claude

# Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=bazobehram/qwen3-14b-claude-4.5-opus-high-reasoning
OLLAMA_TOOL_MODEL=qwen3:14b

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Comma-separated list of authorized Telegram chat IDs
ALLOWED_CHAT_ID=your-chat-id-here

# ── Matrix ───────────────────────────────────────────────────
MATRIX_HOMESERVER=http://localhost:8008
MATRIX_ACCESS_TOKEN=your-matrix-access-token-here
MATRIX_ALLOWED_USERS=@youruser:clauded.local

# ── Voice (Speaches) ────────────────────────────────────────
SPEACHES_URL=http://localhost:8000/v1

# ── Paths ────────────────────────────────────────────────────
# Override default paths (optional)
# STORE_DIR=./store
# WORKSPACE_DIR=./workspace

# ── Ollama Tools ─────────────────────────────────────────────
# Comma-separated allowed paths for the read-file tool
OLLAMA_ALLOWED_PATHS=/Users/your-username/Documents,/Users/your-username/Projects

# Web search (for the web-search tool)
SEARXNG_URL=http://localhost:8888
# Or use Brave Search API instead:
# BRAVE_API_KEY=your-brave-api-key-here

# ── Logging ──────────────────────────────────────────────────
# "debug", "info", "warn", "error"
LOG_LEVEL=info
