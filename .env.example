# ════════════════════════════════════════════════════════════════
# clauded — Environment Configuration
# ════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env — it is gitignored and contains secrets.
#
# After changing .env, restart clauded:
#   docker compose restart clauded
#
# Not sure what to set? Ask clauded: "help me configure the web UI"
# or "what Ollama model should I use?" — it can guide you through
# any setting, even the ones it can't change directly.
#
# ════════════════════════════════════════════════════════════════


# ── MESSAGING PLATFORM (at least one required) ──────────────
#
# You must configure at least one messaging platform (Telegram or Matrix).
# If neither is configured, clauded will refuse to start.


# TELEGRAM
# ────────
# Required if using Telegram (most users start here).
#
# How to get your bot token:
#   1. Open Telegram and message @BotFather
#   2. Send /newbot and follow the prompts
#   3. Copy the token (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
#
# If missing: Telegram bot does not start. If Matrix is also not configured,
# clauded refuses to start entirely.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# SECURITY — Authorized Telegram chat IDs.
# Comma-separated list of numeric chat IDs allowed to use the bot.
#
# How to get your chat ID:
#   1. Leave this empty and start clauded
#   2. Send any message to your bot
#   3. Send /chatid — the bot replies with your numeric ID
#   4. Paste that ID here and restart clauded
#
# WARNING: If empty, the bot accepts messages from ANY Telegram user.
# This is intentional for first-time setup only. Always set this in production.
ALLOWED_CHAT_ID=


# MATRIX (optional)
# ─────────────────
# Self-hosted Matrix homeserver via Synapse. Only needed if you want Matrix
# in addition to (or instead of) Telegram.
#
# Setup guide: reference/matrix-setup.md
#
# If MATRIX_HOMESERVER or MATRIX_ACCESS_TOKEN is empty, Matrix bot does not start.
# MATRIX_HOMESERVER=http://localhost:8008
# MATRIX_ACCESS_TOKEN=your-matrix-access-token-here
#
# SECURITY — Authorized Matrix user IDs. Same rules as ALLOWED_CHAT_ID:
# if empty, ANY Matrix user can message the bot.
# Format: @username:server.domain (comma-separated for multiple)
# MATRIX_ALLOWED_USERS=@youruser:clauded.local


# ── AI PROVIDERS ────────────────────────────────────────────
#
# clauded supports two AI backends. You can use one or both.

# Default AI provider: "claude" or "ollama"
# This is the provider used when auto-routing is off.
AI_PROVIDER=claude

# Automatic provider routing: when true, clauded analyzes each message
# and routes to the best provider (Claude for reasoning, Ollama for tools).
# Toggle at runtime with the /auto command.
# AUTO_ROUTE=false


# CLAUDE
# ──────
# Uses the Claude CLI (claude -p) as a subprocess. Requires a Claude subscription
# (Max plan) and a long-lived OAuth token for headless/Docker usage.
#
# How to generate the token:
#   1. Install Claude CLI: npm install -g @anthropic-ai/claude-code
#   2. Run: claude setup-token
#   3. Follow the browser-based auth flow
#   4. Copy the token output here
#
# The token is valid for approximately 1 year. If Claude stops responding,
# regenerate with: claude setup-token
#
# If missing: Claude provider is unavailable. Ollama still works.
# If expired: Claude requests fail with auth error — regenerate the token.
CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token-here


# OLLAMA
# ──────
# Connects to Ollama running on the host machine (not inside Docker).
# Ollama must be installed and running before starting clauded.
#
# Install: https://ollama.ai
# Pull required models before first run:
#   ollama pull qwen3.5:latest
#   ollama pull nomic-embed-text
#
# If Ollama is not running: Ollama requests fail with connection error.
# The error is shown in chat — clauded does not crash.
# If a model is not pulled: First request fails with "model not found".
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:latest
OLLAMA_TOOL_MODEL=qwen3.5:latest
OLLAMA_EMBED_MODEL=nomic-embed-text


# ── VOICE (Speaches sidecar) ───────────────────────────────
#
# Voice processing is handled by the Speaches Docker container (included
# in docker-compose.yml). It provides local STT and TTS — no cloud services.
#
# STT model: Systran/faster-whisper-small (auto-detects 99 languages)
# TTS model: Kokoro-82M (voices: af_heart for English, ef_dora for Spanish)
#
# Models are loaded automatically by the entrypoint script on first startup
# (takes ~30 seconds). Subsequent starts use cached models.
#
# If Speaches is unreachable: Voice features degrade gracefully — the bot
# transcribes nothing and replies with text only. It does not crash.
#
# You should NOT need to change this unless running Speaches on a different host.
# In Docker, this is automatically overridden to http://speaches:8000/v1
SPEACHES_URL=http://localhost:8000/v1


# ── WEB UI (Voice Chat, Dashboards, Documentation) ─────────
#
# clauded serves a web interface with:
#   - Voice chat (push-to-talk + VAD mode)
#   - Manufacturing dashboards (/sim, /capacity, /sequence, etc.)
#   - Kanban board (/board)
#   - Learning coach (/learn)
#   - Documentation viewer (/docs)
#
# The web UI is DISABLED by default. To enable it, uncomment both lines below.
# Both VOICE_WEB_PORT and VOICE_WEB_TOKEN are required — if either is missing,
# the web server does not start.
#
# VOICE_WEB_PORT: The port to serve the web UI on.
# VOICE_WEB_TOKEN: A secret token for authentication. All web UI connections
#   must provide this token. Choose a strong random string (32+ characters).
#   Example: openssl rand -hex 32
#
# SECURITY: Without a token, ANYONE who can reach the port can use the web UI.
# The server refuses to start if the port is set but the token is empty.
#
# VOICE_WEB_PORT=3030
# VOICE_WEB_TOKEN=your-secret-token-here
#
# TLS / HTTPS (optional, required for non-localhost deployments)
# ──────────
# Browsers require HTTPS for microphone access on non-localhost domains.
# If you access the web UI from a remote machine, you MUST configure TLS.
#
# How to generate a self-signed certificate (for testing):
#   openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 -nodes
#
# For production, use Let's Encrypt or your organization's CA.
#
# If these paths point to files that don't exist, the web server will log an
# error and remain disabled (clauded continues running without the web UI).
#
# VOICE_WEB_TLS_CERT=/path/to/cert.pem
# VOICE_WEB_TLS_KEY=/path/to/key.pem
#
# Allowed Origin (optional, for cloud/remote deployments)
# ───────────────
# When the web UI is accessed from a different domain (not localhost),
# set this to the exact origin URL to prevent cross-site WebSocket hijacking.
# If empty, only localhost connections are allowed (secure default).
#
# Example: https://clauded.example.com
# VOICE_WEB_ORIGIN=


# ── FILE ACCESS (Ollama tools) ──────────────────────────────
#
# The Ollama read_file and parse_file tools can read files from the host.
# For security, access is restricted to paths listed here.
#
# Format: Comma-separated absolute paths. The tool checks if the requested
# file's resolved path starts with any of these prefixes.
#
# If empty: File reading is completely blocked (except uploaded files).
# This is the secure default — set it only if you need file access.
#
# Example (macOS):
# OLLAMA_ALLOWED_PATHS=/Users/yourname/Documents,/Users/yourname/Projects
#
# Example (Linux):
# OLLAMA_ALLOWED_PATHS=/home/yourname/projects,/var/log
OLLAMA_ALLOWED_PATHS=


# ── WEB SEARCH (Ollama tools) ──────────────────────────────
#
# The web_search tool needs a search backend. Configure ONE of these:
#
# Option A: SearXNG (self-hosted, private, recommended)
#   Install: https://docs.searxng.org/admin/installation.html
#   Or via Docker: docker run -p 8888:8080 searxng/searxng
#
# Option B: Brave Search API (cloud, requires API key)
#   Sign up: https://brave.com/search/api/
#   Free tier: 2,000 queries/month
#
# If NEITHER is set: The web_search tool returns an error message
# "No search backend available" — it does not fail silently.
#
# SEARXNG_URL=http://localhost:8888
# BRAVE_API_KEY=your-brave-api-key-here


# ── GITHUB INTEGRATION (optional) ──────────────────────────
#
# Enables GitHub tools: list repos, read files, create PRs, etc.
# Uses the gh CLI installed inside the Docker container.
#
# How to generate:
#   1. Go to https://github.com/settings/tokens
#   2. Create a fine-grained or classic token
#   3. Required scopes: repo, read:org
#
# If missing: GitHub tools return "gh CLI not authenticated" error.
# If expired: GitHub tools return authorization errors — regenerate the token.
# GH_TOKEN=ghp_your-token-here


# ── RENDER INTEGRATION (optional) ──────────────────────────
#
# Enables deployment monitoring tools: list services, check deploys, view logs.
#
# How to generate:
#   1. Go to https://dashboard.render.com/u/settings#api-keys
#   2. Create an API key
#
# If missing: Render tools return "RENDER_API_KEY not set" error.
# RENDER_API_KEY=rnd_your-key-here


# ── PATHS (optional overrides) ──────────────────────────────
#
# Override default data directories. You should NOT need to change these
# unless you have a specific reason. Docker overrides these automatically
# via docker/.env.docker.
#
# STORE_DIR: Where the SQLite database and persistent state are stored.
#   Default: ./store (host) or /app/store (Docker)
#
# WORKSPACE_DIR: Where temporary files (uploads, screenshots, repos) are stored.
#   Default: ./workspace (host) or /app/workspace (Docker)
#
# STORE_DIR=./store
# WORKSPACE_DIR=./workspace


# ── LOGGING ─────────────────────────────────────────────────
#
# Controls the minimum log level. Lower levels include more detail.
# Valid values: debug, info, warn, error
#
# debug  — Everything including internal state changes (verbose)
# info   — Normal operations: startup, connections, tool usage (default)
# warn   — Potential problems: missing optional config, degraded services
# error  — Failures that affect functionality
#
# If invalid value: Defaults to "info" silently.
LOG_LEVEL=info
