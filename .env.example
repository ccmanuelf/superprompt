# clauded — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.

# ── AI Provider ──────────────────────────────────────────────
# Default AI provider: "claude" or "ollama"
AI_PROVIDER=claude

# Claude CLI auth — long-lived OAuth token for headless Docker usage
# Generate with: claude setup-token (valid 1 year)
CLAUDE_CODE_OAUTH_TOKEN=your-claude-oauth-token-here

# Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_TOOL_MODEL=qwen3:latest

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Comma-separated list of authorized Telegram chat IDs
ALLOWED_CHAT_ID=your-chat-id-here

# ── Matrix ───────────────────────────────────────────────────
MATRIX_HOMESERVER=http://localhost:8008
MATRIX_ACCESS_TOKEN=your-matrix-access-token-here
MATRIX_ALLOWED_USERS=@youruser:clauded.local

# ── Voice (Speaches) ────────────────────────────────────────
# STT model: Systran/faster-whisper-small (auto-detects language, supports 99 langs)
# TTS model: speaches-ai/Kokoro-82M-v1.0-ONNX (auto-selects voice: af_heart EN, ef_dora ES)
# Models are loaded automatically by the entrypoint script on container startup.
SPEACHES_URL=http://localhost:8000/v1

# ── Paths ────────────────────────────────────────────────────
# Override default paths (optional)
# STORE_DIR=./store
# WORKSPACE_DIR=./workspace

# ── Ollama Tools ─────────────────────────────────────────────
# Comma-separated allowed paths for the read-file tool
OLLAMA_ALLOWED_PATHS=/Users/your-username/Documents,/Users/your-username/Projects

# Web search (for the web-search tool)
SEARXNG_URL=http://localhost:8888
# Or use Brave Search API instead:
# BRAVE_API_KEY=your-brave-api-key-here

# ── Logging ──────────────────────────────────────────────────
# "debug", "info", "warn", "error"
LOG_LEVEL=info
